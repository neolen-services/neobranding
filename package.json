    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^44.11.5",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
